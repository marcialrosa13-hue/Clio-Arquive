rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. GLOBAL SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. HELPER FUNCTIONS (Phase 3: Primitives)
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Auth tokens do not contain roles; lookup in DB for admin
    function isAdmin() { 
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == "marcialrosa13@gmail.com"
      );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'plan']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.plan in ['free', 'professional', 'institutional'];
    }

    function isValidSource(data) {
      return data.keys().hasAll(['source', 'createdAt']) &&
             data.source is map &&
             data.createdAt == request.time;
    }

    function isValidSearch(data) {
      return data.keys().hasAll(['query', 'result', 'createdAt']) &&
             data.query is string && data.query.size() <= 500 &&
             data.createdAt == request.time;
    }

    // 3. RESOURCE RULES
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().plan == 'free';
      allow update: if isAdmin() || (isOwner(userId) && incoming().plan == existing().plan && incoming().uid == existing().uid);

      match /saved_sources/{sourceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sourceId) && isValidSource(incoming());
        allow delete: if isOwner(userId);
      }

      match /saved_searches/{searchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(searchId) && isValidSearch(incoming());
        allow delete: if isOwner(userId);
      }

      match /lesson_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(planId) && incoming().keys().hasAll(['title', 'objective']);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /institutions/{instId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /usage_logs/{logId} {
      allow create: if isSignedIn() && incoming().uid == request.auth.uid && incoming().timestamp == request.time;
      allow read: if isAdmin();
    }
  }
}
