rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - plan: string (free, professional, institutional)
    //   - role: string (user, admin, inst_admin)
    //   - institutionId: string (optional)
    //
    // Collection: institutions
    // Document ID: {instId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - adminUid: string (required)
    //
    // Collection: usage_logs
    // Document ID: {logId}
    // Fields:
    //   - uid: string (required)
    //   - feature: string (required)
    //   - timestamp: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "marcialrosa13@gmail.com");
    }

    function isInstitutionalAdmin(instId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/institutions/$(instId)).data.adminUid == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'plan']) &&
             data.uid is string &&
             data.email is string &&
             data.plan in ['free', 'professional', 'institutional'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.plan == 'free';
      allow update: if (isOwner(userId) && request.resource.data.plan == resource.data.plan) || isAdmin();
      
      match /saved_sources/{sourceId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /institutions/{instId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isInstitutionalAdmin(instId) || isAdmin();
    }

    match /usage_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && isInstitutionalAdmin(request.resource.data.institutionId));
    }
  }
}
